# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/
!mvnw
!mvnw.cmd

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Node / frontend (frontend/.gitignore, generated by the Angular CLI, covers
# frontend/dist, node_modules, etc. within that directory)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# App runtime data (never commit local persistence or key material)
data/
*.ppk
*.log
logs/

# Release packaging (release.sh embeds the built Angular app here, then
# assembles a distributable release/ folder — both are build output, not source)
backend/src/main/resources/static/
release/

# Env
.env
.env.local
