# Supply-chain safety: refuse to install any package version published less
# than 3 days (72 hours) ago. This gives the community time to catch and pull
# malicious/compromised releases before they can end up in this project.
#
# Requires npm >= 11.10.0. On older npm this key is silently ignored (no
# error, no enforcement) — check with `npm --version` and upgrade if needed.
min-release-age=3
